---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <language>ja</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% comment %} blog/ と articles/ の両方を新しい順に束ねる（Jekyllのpagesから日付付きのものを収集） {% endcomment %}
    {% assign feed_pages = site.pages | where_exp: "p", "p.date" | sort: "date" | reverse %}
    {% for p in feed_pages limit: 40 %}
    <item>
      <title>{{ p.title | xml_escape }}</title>
      <description>{{ p.description | default: site.description | xml_escape }}</description>
      <link>{{ p.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ p.url | absolute_url }}</guid>
      <pubDate>{{ p.date | date_to_rfc822 }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
